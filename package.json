{
  "name": "bangumi-pocket",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:sync": "npm run build && cap sync android",
    "android:build": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "test": "node scripts/test-ui.mjs",
    "test:sync": "node scripts/test-sync.mjs",
    "test:timeline": "node scripts/test-timeline-freshness.mjs",
    "test:detail": "node scripts/test-detail.mjs",
    "test:library": "node scripts/test-library.mjs",
    "test:air": "node scripts/test-air-progress.mjs",
    "test:updates": "node scripts/test-updates.mjs",
    "test:startup-updates": "node scripts/test-startup-updates.mjs",
    "test:update-download": "node scripts/test-update-download.mjs",
    "test:text": "node scripts/test-text.mjs",
    "android:release": "powershell -ExecutionPolicy Bypass -File scripts/release-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "entities": "^8.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "https-proxy-agent": "^9.1.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
